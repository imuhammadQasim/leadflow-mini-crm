# Each sub-project (api/, react-dashboard/, angular-insights/, wordpress-plugin/) has its own
# .gitignore for stack-specific ignores. This root one is a safety net for anything created
# outside those folders or missed by them.

# Dependencies / build output
node_modules/
dist/
build/
.angular/

# Environment files - never commit real secrets
.env
.env.local
.env.*.local

# OS / editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
