# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/leadflow

# JWT auth for the React/Angular dashboards
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Seed admin account (created automatically on first server start if no admin exists)
ADMIN_EMAIL=admin@leadflow.test
ADMIN_PASSWORD=ChangeMe123!

# Shared secret the WordPress plugin must send (as x-api-key header) to sync leads
WORDPRESS_API_SECRET=replace_with_a_shared_secret

# Comma-separated list of origins allowed to call this API (dashboard URLs)
CORS_ORIGIN=http://localhost:5173,http://localhost:4200/